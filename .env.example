# ShopMind AI Production & Local Environment Template
PORT=8000
HOST=0.0.0.0
ENV=production

# LLM Configuration
# Options: mock, ollama, openai
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite:///./shopmind.db

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shopmind-ai.vercel.app

# RAG & Vector Store Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./app/data/faiss_index
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Cache Configuration
CACHE_TTL=300

# Frontend Public API URL (Used by Vercel deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
